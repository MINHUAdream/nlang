let X = tensor([[1.0, 0.0, 0.5, 0.2, 0.1, 0.8, 0.3, 0.6, 0.4, 0.9, 0.7, 0.2, 0.5, 0.1, 0.8, 0.3],
                [0.3, 1.0, 0.1, 0.4, 0.9, 0.2, 0.7, 0.5, 0.6, 0.1, 0.8, 0.3, 0.4, 0.9, 0.2, 0.7],
                [0.2, 0.5, 1.0, 0.3, 0.8, 0.1, 0.6, 0.4, 0.9, 0.7, 0.2, 0.5, 0.1, 0.8, 0.3, 0.6],
                [0.6, 0.1, 0.8, 1.0, 0.3, 0.5, 0.2, 0.9, 0.4, 0.7, 0.1, 0.8, 0.6, 0.2, 0.5, 0.3],
                [0.4, 0.9, 0.2, 0.5, 1.0, 0.3, 0.7, 0.1, 0.8, 0.6, 0.4, 0.2, 0.9, 0.5, 0.1, 0.7],
                [0.7, 0.3, 0.6, 0.1, 0.8, 1.0, 0.4, 0.2, 0.5, 0.9, 0.3, 0.7, 0.1, 0.6, 0.4, 0.8],
                [0.1, 0.8, 0.4, 0.7, 0.2, 0.6, 1.0, 0.3, 0.9, 0.5, 0.1, 0.8, 0.7, 0.4, 0.2, 0.6],
                [0.9, 0.2, 0.7, 0.6, 0.4, 0.1, 0.8, 1.0, 0.3, 0.5, 0.7, 0.4, 0.2, 0.9, 0.6, 0.1]])
let Wq = param([16, 16])
let Wk = param([16, 16])
let Wv = param([16, 16])
let Q = matmul(X, Wq)
let K = matmul(X, Wk)
let V = matmul(X, Wv)
let d = tensor([2.0])
let scores = scaled_mm_t(Q, K, d)
let attn = softmax(scores)
let ctx = matmul(attn, V)
let h = add(ctx, X)
let W1 = param([16, 16])
let b1 = param([16])
let f = affine(relu(h), W1, b1)
let out = add(f, h)
let target = tensor([[1.0, 0.0, 0.5, 0.2, 0.1, 0.8, 0.3, 0.6, 0.4, 0.9, 0.7, 0.2, 0.5, 0.1, 0.8, 0.3],
                     [0.3, 1.0, 0.1, 0.4, 0.9, 0.2, 0.7, 0.5, 0.6, 0.1, 0.8, 0.3, 0.4, 0.9, 0.2, 0.7],
                     [0.2, 0.5, 1.0, 0.3, 0.8, 0.1, 0.6, 0.4, 0.9, 0.7, 0.2, 0.5, 0.1, 0.8, 0.3, 0.6],
                     [0.6, 0.1, 0.8, 1.0, 0.3, 0.5, 0.2, 0.9, 0.4, 0.7, 0.1, 0.8, 0.6, 0.2, 0.5, 0.3],
                     [0.4, 0.9, 0.2, 0.5, 1.0, 0.3, 0.7, 0.1, 0.8, 0.6, 0.4, 0.2, 0.9, 0.5, 0.1, 0.7],
                     [0.7, 0.3, 0.6, 0.1, 0.8, 1.0, 0.4, 0.2, 0.5, 0.9, 0.3, 0.7, 0.1, 0.6, 0.4, 0.8],
                     [0.1, 0.8, 0.4, 0.7, 0.2, 0.6, 1.0, 0.3, 0.9, 0.5, 0.1, 0.8, 0.7, 0.4, 0.2, 0.6],
                     [0.9, 0.2, 0.7, 0.6, 0.4, 0.1, 0.8, 1.0, 0.3, 0.5, 0.7, 0.4, 0.2, 0.9, 0.6, 0.1]])
let loss = mean(square(sub(out, target)))
